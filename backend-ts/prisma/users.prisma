model User {
  user_id     Int     @id @default(autoincrement())
  email       String  @unique @db.VarChar(60)
  password    String  @db.VarChar(30)

  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  notes       Note[]   // One User → Many Notes

  @@map("users")
}


